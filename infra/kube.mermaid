flowchart TB
    Browser[React UI<br/>Browser]

    subgraph K8s["kind Kubernetes Cluster"]
        Ingress[ingress-nginx<br/>local 8080/8443]

        subgraph AppNS["Namespace: internship"]
            BackendSvc[Service backend]
            BackendPods[FastAPI Deployment]
            ChatSvc[Service chat-service]
            ChatPods[Socket.IO Deployment]
            HPA[HPA + PDB]

            MigrateJob[Alembic Migration Job]
            ChatInitJob[DynamoDB Init Job]

            Postgres[(PostgreSQL)]
            Redis[(Redis)]
            Dynamo[(DynamoDB Local)]
        end

        subgraph MonitorNS["Namespace: monitoring"]
            Prometheus[Prometheus Operator]
            Grafana[Grafana]
            Alertmanager[Alertmanager]
            KubeMetrics[kube-state-metrics]
            Loki[Loki]
            Alloy[Grafana Alloy]
            OTel[OpenTelemetry Collector]
            Tempo[Tempo]
        end
    end

    Browser --> Ingress
    Ingress --> BackendSvc --> BackendPods
    Ingress --> ChatSvc --> ChatPods

    BackendPods --> Postgres
    ChatPods --> Redis
    ChatPods --> Dynamo
    HPA --> BackendPods
    HPA --> ChatPods

    MigrateJob --> Postgres
    ChatInitJob --> Dynamo

    Prometheus -->|ServiceMonitor| BackendSvc
    Prometheus -->|ServiceMonitor| ChatSvc

    Alloy -->|Pod logs| Loki
    BackendPods -->|OTLP traces| OTel
    ChatPods -->|OTLP traces| OTel
    OTel --> Tempo
    Grafana --> Prometheus
    Grafana --> Loki
    Grafana --> Tempo
