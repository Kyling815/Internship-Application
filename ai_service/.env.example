# Local model path. In Docker, mount ./models to /app/models and use /app/models/qwen3-reranker-0.6b.
QWEN_RERANKER_MODEL_PATH=./models/qwen3-reranker-0.6b

# Device can be auto, cuda, or cpu. auto uses CUDA when torch.cuda.is_available().
QWEN_RERANKER_DEVICE=auto

# MVP calibration and request limits.
QWEN_SCORE_TEMPERATURE=3.0
QWEN_MAX_TEXT_CHARS=12000
QWEN_MAX_PAIRS=128
QWEN_MAX_CANDIDATES=50
QWEN_BATCH_PAIR_SIZE=32
QWEN_BATCH_MAX_TOTAL_PAIRS=512

# Server defaults used by helper commands and deployment docs.
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8010

# Optional API key protection.
# If empty, no API key is required.
# If set, clients must send: X-AI-Service-Key: <key>
AI_SERVICE_API_KEY=
