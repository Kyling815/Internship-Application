@import url("https://fonts.googleapis.com/css2?family=Afacad+Flux:wght@400..1000&family=Fraunces:opsz,wght@9..144,500..900&display=swap");

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --app-display-font: "Fraunces", "Afacad Flux", Georgia, serif;
  --app-body-font: "Afacad Flux", "Montserrat", ui-sans-serif, system-ui, sans-serif;
  --atlas-night: #071a2b;
  --atlas-ink: #102a43;
  --atlas-muted: #52677a;
  --atlas-paper: #fffdf6;
  --atlas-cream: #f7eedd;
  --atlas-mist: #f6fafc;
  --atlas-blue: #008dda;
  --atlas-cyan: #41c9e2;
  --atlas-aqua: #ace2e1;
  --atlas-line: rgba(16, 42, 67, 0.12);
  --atlas-shadow: 0 22px 55px rgba(7, 26, 43, 0.09);

  --candidate-primary: #008DDA;
  --candidate-primary-hover: #0078BD;
  --candidate-secondary: #41C9E2;
  --candidate-aqua: #ACE2E1;
  --candidate-cream: #F7EEDD;

  --candidate-ink: #102A43;
  --candidate-ink-strong: #071827;
  --candidate-muted: #62758A;

  --candidate-surface: #fffdf6;
  --candidate-surface-soft: #edf8fb;
  --candidate-surface-warm: #F7EEDD;

  --candidate-border: rgba(16, 42, 67, 0.12);
  --candidate-border-strong: rgba(16, 42, 67, 0.2);

  --candidate-success: #16866A;
  --candidate-warning: #B7791F;
  --candidate-danger: #C53D4D;

  --candidate-focus: #008DDA;

  color: var(--atlas-ink);
  background: var(--atlas-cream);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 10%, rgba(65, 201, 226, 0.24), transparent 24rem),
    radial-gradient(circle at 86% 18%, rgba(0, 141, 218, 0.16), transparent 28rem),
    linear-gradient(115deg, #fffdf6 0%, #f6fafc 52%, #f7eedd 100%);
  color: var(--atlas-ink);
  font-family: var(--app-body-font);
  font-weight: 500;
}

body::before {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  content: "";
  background:
    linear-gradient(90deg, rgba(16, 42, 67, 0.035) 1px, transparent 1px),
    linear-gradient(180deg, rgba(16, 42, 67, 0.035) 1px, transparent 1px);
  background-size: 68px 68px;
  mask-image: linear-gradient(180deg, black, transparent 82%);
}

h1,
h2,
h3,
.candidate-title,
.homepage-hero h1,
.section-kicker h2,
.application-journey h2,
.readiness-preview h2,
.opportunity-section h2,
.tracker-preview h2,
.final-cta h2 {
  font-family: var(--app-display-font);
  font-variation-settings: "SOFT" 70;
}

button,
input,
select,
textarea {
  font: inherit;
}

a,
button,
input,
select,
textarea {
  outline-color: var(--atlas-blue);
}

@layer base {
  ::selection {
    background: rgba(65, 201, 226, 0.34);
    color: var(--atlas-night);
  }
}

@layer components {
  .aesthetic-auth {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 16% 16%, rgba(65, 201, 226, 0.32), transparent 24rem),
      radial-gradient(circle at 82% 18%, rgba(0, 141, 218, 0.22), transparent 28rem),
      linear-gradient(135deg, #071a2b 0%, #102a43 46%, #f7eedd 46.2%, #fffdf6 100%);
  }

  .aesthetic-auth::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: linear-gradient(90deg, black, transparent 58%);
  }

  .aesthetic-auth-card {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-radius: 1.15rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 253, 246, 0.82)),
      var(--atlas-paper);
    box-shadow: 0 28px 70px rgba(7, 26, 43, 0.18);
    backdrop-filter: blur(18px);
  }

  .aesthetic-auth-card h1 {
    font-family: var(--app-display-font);
    color: var(--atlas-night);
    font-size: 1.7rem;
    line-height: 1.02;
  }

  .aesthetic-auth-mark {
    border-radius: 0.9rem;
    background: var(--atlas-blue);
    color: white;
    box-shadow: 0 16px 36px rgba(0, 141, 218, 0.32);
  }

  .aesthetic-auth input,
  .aesthetic-auth select {
    border-color: rgba(16, 42, 67, 0.18) !important;
    border-radius: 0.8rem !important;
    background: rgba(255, 255, 255, 0.82);
  }

  .aesthetic-auth input:focus,
  .aesthetic-auth select:focus {
    border-color: var(--atlas-blue) !important;
    box-shadow: 0 0 0 4px rgba(0, 141, 218, 0.14) !important;
  }

  .aesthetic-auth button[type="submit"] {
    border-radius: 0.8rem;
    background: var(--atlas-night);
    box-shadow: 0 16px 36px rgba(7, 26, 43, 0.18);
  }

  .app-shell {
    position: relative;
    min-height: 100vh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 8% 8%, rgba(65, 201, 226, 0.2), transparent 26rem),
      radial-gradient(circle at 92% 18%, rgba(172, 226, 225, 0.34), transparent 24rem),
      linear-gradient(120deg, #f7eedd 0%, #edf8fb 46%, #fffdf6 100%);
    color: var(--atlas-ink);
  }

  .app-shell::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    content: "";
    background:
      linear-gradient(90deg, rgba(16, 42, 67, 0.032) 1px, transparent 1px),
      linear-gradient(180deg, rgba(16, 42, 67, 0.032) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(180deg, black, transparent 86%);
  }

  .app-shell > * {
    position: relative;
    z-index: 1;
  }

  .app-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 30;
    width: 17.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow: visible; /* To allow tooltips to show outside */
    border-right: 1px solid rgba(16, 42, 67, 0.12);
    background:
      linear-gradient(180deg, rgba(255, 253, 246, 0.96), rgba(237, 248, 251, 0.92)),
      var(--candidate-surface);
    padding: 1.25rem 0.8rem;
    box-shadow: 12px 0 40px rgba(7, 26, 43, 0.05);
    backdrop-filter: blur(18px);
    transition: width 240ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 180ms ease;
  }

  .app-sidebar.is-collapsed {
    width: 5rem;
  }

  .app-sidebar__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding-bottom: 0.5rem;
  }

  .app-sidebar__top.is-collapsed {
    justify-content: center;
  }

  .app-brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.65rem;
  }

  .app-brand__mark,
  .app-footer__mark {
    display: inline-flex;
    height: 2.25rem;
    width: 2.25rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 0.8rem;
    background: var(--atlas-night);
    color: white;
    box-shadow: 0 14px 32px rgba(7, 26, 43, 0.18);
  }

  .app-brand__text {
    min-width: 0;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .app-brand__text p {
    overflow: hidden;
    color: var(--atlas-night);
    font-size: 0.95rem;
    font-weight: 900;
    line-height: 1.05;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-brand__text span {
    color: var(--atlas-muted);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .app-brand.is-compact .app-brand__text {
    width: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-0.25rem);
  }

  .app-sidebar.is-collapsed .app-nav-link__label,
  .app-sidebar.is-collapsed .app-sidebar__account .account-info,
  .app-sidebar.is-collapsed .app-sidebar__logout span {
    width: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-0.25rem);
    position: absolute;
    left: 100%;
  }

  .app-icon-button {
    display: inline-flex;
    min-height: 2.25rem;
    min-width: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(16, 42, 67, 0.13);
    border-radius: 0.75rem;
    background: rgba(255, 253, 246, 0.72);
    color: var(--atlas-ink);
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .app-icon-button:hover,
  .app-icon-button:focus-visible {
    border-color: rgba(0, 141, 218, 0.38);
    background: rgba(237, 248, 251, 0.9);
    transform: translateY(-1px);
  }

  .app-sidebar__account {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    overflow: hidden;
    border: 1px solid rgba(16, 42, 67, 0.09);
    border-radius: 0.9rem;
    background: rgba(255, 253, 246, 0.58);
    padding: 0.5rem;
    transition: all 180ms ease;
  }

  .app-sidebar__account.is-compact {
    padding: 0.4rem;
    justify-content: center;
    border-color: transparent;
    background: transparent;
  }

  .account-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.65rem;
    background: var(--atlas-blue);
    color: white;
    font-weight: 800;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .account-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .account-info p {
    overflow: hidden;
    color: var(--atlas-ink);
    font-size: 0.78rem;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account-info span {
    color: var(--atlas-blue);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .app-sidebar__scroll-area {
    flex: 1 1 auto;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .app-sidebar__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  
  .app-sidebar__nav-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .app-sidebar__nav-label {
    padding: 0 0.78rem;
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--atlas-muted);
    margin-top: 0.5rem;
    margin-bottom: 0.2rem;
    transition: opacity 180ms ease;
  }
  
  .app-sidebar.is-collapsed .app-sidebar__nav-label {
    opacity: 0;
    pointer-events: none;
  }
  
  .app-sidebar__search {
    margin-bottom: 0.5rem;
  }
  
  .app-sidebar__search.is-compact {
    display: flex;
    justify-content: center;
  }
  
  .app-sidebar__search-btn {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }
  
  .app-sidebar__search-btn:hover {
    background: rgba(172, 226, 225, 0.32);
    border-color: transparent;
  }
  
  .app-sidebar__search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  
  .app-sidebar__search-icon {
    position: absolute;
    left: 0.8rem;
    color: var(--atlas-muted);
    pointer-events: none;
    transition: all 180ms ease;
  }
  
  .app-sidebar__search-input {
    width: 100%;
    border: 1px solid rgba(16, 42, 67, 0.13);
    border-radius: 0.8rem;
    background: rgba(255, 255, 255, 0.6);
    padding: 0.6rem 0.8rem 0.6rem 2.2rem;
    font-size: 0.85rem;
    color: var(--atlas-ink);
    transition: all 180ms ease;
  }
  
  .app-sidebar.is-collapsed .app-sidebar__search-input {
    color: transparent;
    background: transparent;
    border-color: transparent;
    pointer-events: none;
  }
  
  .app-sidebar.is-collapsed .app-sidebar__search-input::placeholder {
    color: transparent;
  }
  
  .app-sidebar.is-collapsed .app-sidebar__search-icon {
    left: 50%;
    transform: translateX(-50%);
  }
  
  .app-sidebar__search-input:focus {
    outline: none;
    background: white;
    border-color: var(--atlas-blue);
    box-shadow: 0 0 0 3px rgba(0, 141, 218, 0.1);
  }

  .app-nav {
    display: grid;
    gap: 0.35rem;
  }

  .app-nav-link {
    display: flex;
    min-height: 2.55rem;
    align-items: center;
    gap: 0.7rem;
    overflow: hidden;
    border-radius: 0.8rem;
    padding: 0 0.78rem;
    color: var(--atlas-muted);
    font-size: 0.86rem;
    font-weight: 850;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .app-nav-link svg {
    flex: 0 0 auto;
  }

  .app-nav-link__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .app-nav-link:hover,
  .app-nav-link:focus-visible {
    background: rgba(172, 226, 225, 0.32);
    color: var(--atlas-night);
  }

  .app-nav-link.is-active {
    background: var(--candidate-surface-soft);
    color: var(--atlas-night);
    box-shadow: 0 2px 8px rgba(16, 42, 67, 0.05);
    border: 1px solid var(--candidate-border);
  }
  
  .app-nav-link.is-active svg {
    color: var(--atlas-blue);
  }

  .app-nav-link--compact {
    justify-content: center;
    padding: 0;
  }
  
  .app-nav-link--compact svg {
    margin: 0 auto;
  }

  .app-sidebar__logout {
    display: flex;
    min-height: 2.55rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border: 1px solid rgba(16, 42, 67, 0.13);
    border-radius: 0.82rem;
    background: rgba(255, 253, 246, 0.72);
    color: var(--atlas-ink);
    font-size: 0.86rem;
    font-weight: 850;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
    cursor: pointer;
  }
  
  .app-sidebar__logout--compact {
    padding: 0;
  }

  .app-sidebar__logout:hover,
  .app-sidebar__logout:focus-visible {
    background: rgba(197, 61, 77, 0.1);
    color: var(--candidate-danger);
    transform: translateY(-1px);
  }

  .app-tooltip {
    background: var(--atlas-night);
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(7, 26, 43, 0.2);
    z-index: 100;
    pointer-events: none;
    animation: tooltip-fade-in 180ms ease-out both;
  }
  
  @keyframes tooltip-fade-in {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .app-content {
    min-width: 0;
    transition: padding-left 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  
  @media (min-width: 1024px) {
    .app-content {
      padding-left: 19.5rem;
    }
    
    .app-sidebar.is-collapsed ~ .app-content {
      padding-left: 7rem;
    }
  }

  .app-mobile-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 2.25rem;
    align-items: center;
    gap: 0.65rem;
    border-bottom: 1px solid rgba(16, 42, 67, 0.1);
    background: rgba(255, 253, 246, 0.82);
    padding: 0.65rem 0.8rem;
    backdrop-filter: blur(16px);
  }

  .app-mobile-bar .app-brand {
    justify-content: center;
  }

  .app-mobile-bar .app-brand__mark {
    height: 2rem;
    width: 2rem;
    border-radius: 0.7rem;
  }

  .app-mobile-bar .app-brand__text p {
    max-width: 12rem;
    font-size: 0.9rem;
  }

  .app-mobile-bar .app-brand__text span {
    display: none;
  }

  .app-mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 50;
  }

  .app-mobile-drawer__scrim {
    position: absolute;
    inset: 0;
    background: rgba(7, 26, 43, 0.28);
    backdrop-filter: blur(3px);
  }

  .app-mobile-drawer__panel {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    width: min(19rem, calc(100vw - 2.75rem));
    flex-direction: column;
    gap: 1rem;
    border-right: 1px solid rgba(255, 255, 255, 0.65);
    background:
      linear-gradient(180deg, rgba(255, 253, 246, 0.96), rgba(237, 248, 251, 0.9)),
      var(--candidate-surface);
    padding: 0.9rem;
    box-shadow: 24px 0 60px rgba(7, 26, 43, 0.18);
    animation: mobile-drawer-enter 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .app-footer {
    display: grid;
    gap: 1rem;
    align-items: center;
    border: 1px solid rgba(16, 42, 67, 0.1);
    border-radius: 1rem;
    background:
      linear-gradient(135deg, rgba(255, 253, 246, 0.82), rgba(237, 248, 251, 0.72)),
      rgba(255, 253, 246, 0.78);
    padding: 1rem;
    color: var(--atlas-muted);
    box-shadow: 0 18px 42px rgba(7, 26, 43, 0.07);
  }

  .app-footer__brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.7rem;
  }

  .app-footer__brand p {
    color: var(--atlas-night);
    font-weight: 900;
    line-height: 1.1;
  }

  .app-footer__brand span,
  .app-footer__links a,
  .app-footer__meta span {
    font-size: 0.82rem;
    font-weight: 750;
  }

  .app-footer__links,
  .app-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
  }

  .app-footer__links a {
    color: var(--atlas-ink);
    text-decoration: none;
  }

  .app-footer__links a:hover {
    color: var(--atlas-blue);
  }

  .app-footer__meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .route-panel {
    animation: route-panel-enter 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .route-panel > div:not(.candidate-shell):not(.profile-page) {
    color: var(--atlas-ink);
  }

  .route-panel h1 {
    font-family: var(--app-display-font);
    color: var(--atlas-night);
    font-weight: 850;
    letter-spacing: 0;
  }

  .route-panel h2,
  .route-panel h3 {
    color: var(--atlas-night);
  }

  .route-panel .rounded-lg.border.border-zinc-200.bg-white,
  .route-panel .rounded-lg.border.border-zinc-200.bg-zinc-50,
  .route-panel .overflow-hidden.rounded-lg.border.border-zinc-200.bg-white {
    border-color: var(--atlas-line) !important;
    border-radius: 0.9rem !important;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 253, 246, 0.82)),
      var(--atlas-paper) !important;
    box-shadow: var(--atlas-shadow) !important;
  }

  .route-panel input,
  .route-panel select,
  .route-panel textarea {
    border-color: rgba(16, 42, 67, 0.18);
    border-radius: 0.75rem;
  }

  .route-panel input:focus,
  .route-panel select:focus,
  .route-panel textarea:focus {
    border-color: var(--atlas-blue) !important;
    box-shadow: 0 0 0 4px rgba(0, 141, 218, 0.14) !important;
  }

  .route-panel a.bg-zinc-900,
  .route-panel button.bg-zinc-900 {
    background: var(--atlas-night) !important;
    box-shadow: 0 14px 32px rgba(7, 26, 43, 0.16);
  }

  .candidate-shell {
    color: var(--candidate-ink);
  }

  .candidate-page {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .candidate-hero {
    position: relative;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: 1rem;
    background:
      linear-gradient(112deg, rgba(255, 255, 255, 0.94) 0%, rgba(246, 251, 253, 0.92) 52%, rgba(247, 238, 221, 0.78) 100%);
    padding: 1.25rem;
  }

  .candidate-hero::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    background:
      radial-gradient(circle at 10% 15%, rgba(65, 201, 226, 0.24), transparent 18rem),
      radial-gradient(circle at 88% 8%, rgba(0, 141, 218, 0.16), transparent 20rem);
  }

  .candidate-hero > * {
    position: relative;
  }

  .candidate-eyebrow {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--candidate-primary);
  }

  .candidate-title {
    margin-top: 0.25rem;
    max-width: 52rem;
    color: var(--candidate-ink-strong);
    font-size: clamp(1.75rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.03;
    letter-spacing: 0;
  }

  .candidate-copy {
    margin-top: 0.75rem;
    max-width: 43rem;
    color: var(--candidate-muted);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .candidate-surface {
    border: 1px solid var(--candidate-border);
    border-radius: 0.75rem;
    background: var(--candidate-surface);
    box-shadow: 0 18px 48px rgba(16, 42, 67, 0.07);
  }

  .candidate-soft-surface {
    border-radius: 0.75rem;
    background: var(--candidate-surface-soft);
  }

  .candidate-divider {
    border-top: 1px solid var(--candidate-border);
  }

  .candidate-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.65rem;
    padding: 0.65rem 1rem;
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.2;
    transition:
      transform 160ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      opacity 180ms ease;
  }

  .candidate-button:hover,
  .candidate-button:focus-visible {
    transform: translateY(-1px);
  }

  .candidate-button:active {
    transform: translateY(0);
  }

  .candidate-button:disabled,
  .candidate-button[aria-disabled="true"] {
    cursor: not-allowed;
    opacity: 0.62;
    transform: none;
  }

  .candidate-button--primary {
    background: var(--candidate-primary);
    color: white;
    box-shadow: 0 14px 30px rgba(0, 141, 218, 0.22);
  }

  .candidate-button--primary:hover,
  .candidate-button--primary:focus-visible {
    background: var(--candidate-primary-hover);
  }

  .candidate-button--secondary {
    border: 1px solid var(--candidate-border-strong);
    background: rgba(255, 255, 255, 0.78);
    color: var(--candidate-ink);
  }

  .candidate-button--secondary:hover,
  .candidate-button--secondary:focus-visible {
    border-color: var(--candidate-primary);
    color: var(--candidate-primary-hover);
  }

  .candidate-button--danger {
    border: 1px solid rgba(197, 61, 77, 0.28);
    background: white;
    color: var(--candidate-danger);
  }

  .candidate-field {
    display: block;
  }

  .candidate-label {
    display: block;
    color: var(--candidate-ink);
    font-size: 0.875rem;
    font-weight: 800;
  }

  .candidate-control {
    margin-top: 0.45rem;
    width: 100%;
    border: 1px solid var(--candidate-border-strong);
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.94);
    padding: 0.72rem 0.85rem;
    color: var(--candidate-ink-strong);
    outline: 0;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      background-color 160ms ease;
  }

  .candidate-control:focus {
    border-color: var(--candidate-focus);
    background: white;
    box-shadow: 0 0 0 4px rgba(0, 141, 218, 0.14);
  }

  .candidate-helper {
    margin-top: 0.4rem;
    color: var(--candidate-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .candidate-list-row {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 0;
  }

  .candidate-list-row + .candidate-list-row {
    border-top: 1px solid var(--candidate-border);
  }

  .candidate-skeleton {
    position: relative;
    overflow: hidden;
    background: rgba(172, 226, 225, 0.38);
  }

  .candidate-skeleton::after {
    position: absolute;
    inset: 0;
    content: "";
    transform: translateX(-100%);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.78), transparent);
    animation: profile-shimmer 1.15s infinite;
  }

  .profile-page {
    --profile-ink: var(--candidate-ink);
    --profile-muted: var(--candidate-muted);
    --profile-line: var(--candidate-border);
    --profile-surface: var(--candidate-surface);
    color: var(--profile-ink);
  }

  .profile-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--candidate-primary);
  }

  .profile-hero {
    position: relative;
    display: grid;
    gap: 1.25rem;
    overflow: hidden;
    border: 1px solid rgba(153, 246, 228, 0.75);
    border-radius: 1.25rem;
    background:
      radial-gradient(circle at 12% 12%, rgba(65, 201, 226, 0.2), transparent 23rem),
      radial-gradient(circle at 88% 16%, rgba(247, 238, 221, 0.7), transparent 22rem),
      linear-gradient(135deg, #f6fbfd 0%, #ffffff 58%, #f7eedd 100%);
    padding: 1.25rem;
    box-shadow: 0 24px 70px rgba(15, 23, 42, 0.08);
  }

  .profile-hero__content,
  .profile-preview,
  .profile-section {
    animation: profile-reveal 480ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--profile-delay, 0ms);
  }

  .profile-hero__content {
    --profile-delay: 60ms;
  }

  .profile-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    padding: 0.45rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--candidate-ink);
    box-shadow: inset 0 0 0 1px rgba(153, 246, 228, 0.7);
  }

  .profile-hero__title {
    margin-top: 1rem;
    max-width: 42rem;
    font-size: clamp(2rem, 6vw, 3.75rem);
    font-weight: 750;
    line-height: 1;
    letter-spacing: 0;
    color: var(--candidate-ink-strong);
  }

  .profile-hero__copy {
    margin-top: 1rem;
    max-width: 39rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--candidate-muted);
  }

  .profile-proof {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.875rem;
    background: rgba(255, 255, 255, 0.76);
    padding: 0.65rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #334155;
    box-shadow: inset 0 0 0 1px rgba(226, 232, 240, 0.85);
  }

  .profile-preview {
    --profile-delay: 180ms;
    border: 1px solid rgba(203, 213, 225, 0.9);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.88);
    padding: 1rem;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.14);
    backdrop-filter: blur(18px);
  }

  .profile-avatar {
    display: flex;
    height: 3.25rem;
    width: 3.25rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    background: var(--candidate-ink-strong);
    color: #ffffff;
    font-weight: 800;
    letter-spacing: 0;
  }

  .profile-preview__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-radius: 0.875rem;
    background: #f8fafc;
    padding: 0.8rem;
  }

  .profile-preview__row dt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #64748b;
    font-size: 0.875rem;
  }

  .profile-preview__row dd {
    max-width: 50%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #0f172a;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .profile-section {
    border: 1px solid var(--profile-line);
    border-radius: 1rem;
    background: var(--profile-surface);
    padding: 1rem;
    box-shadow: 0 16px 45px rgba(15, 23, 42, 0.06);
  }

  .profile-field {
    display: block;
  }

  .profile-field__label {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    color: #334155;
  }

  .profile-field__control {
    margin-top: 0.45rem;
    display: flex;
    min-height: 2.875rem;
    align-items: center;
    gap: 0.625rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.875rem;
    background: #ffffff;
    padding: 0 0.8rem;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      background-color 160ms ease;
  }

  .profile-field__control:focus-within {
    border-color: var(--candidate-primary);
    background: #faffff;
    box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.16);
  }

  .profile-input {
    min-width: 0;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 0.7rem 0;
    color: #0f172a;
    outline: 0;
  }
  
  input.profile-input:focus,
  input.profile-input:focus-visible {
    outline: none !important;
    box-shadow: none !important;
    border: none !important;
    border-color: transparent !important;
    background-color: transparent !important;
    --tw-ring-shadow: 0 0 #0000 !important;
    --tw-ring-offset-shadow: 0 0 #0000 !important;
  }

  .profile-input::placeholder,
  .profile-textarea::placeholder {
    color: #94a3b8;
  }

  .profile-textarea {
    margin-top: 0.45rem;
    width: 100%;
    resize: vertical;
    border: 1px solid #cbd5e1;
    border-radius: 0.875rem;
    background: #ffffff;
    padding: 0.85rem 0.95rem;
    color: #0f172a;
    outline: 0;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      background-color 160ms ease;
  }

  textarea.profile-textarea:focus,
  textarea.profile-textarea:focus-visible {
    border-color: var(--candidate-primary) !important;
    background-color: #faffff !important;
    box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.16) !important;
    outline: 0 !important;
    --tw-ring-shadow: 0 0 #0000 !important;
    --tw-ring-offset-shadow: 0 0 #0000 !important;
  }

  .profile-field__helper {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #64748b;
  }

  .profile-primary-action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.875rem;
    background: var(--candidate-primary);
    padding: 0.7rem 1rem;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 800;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.18);
    transition:
      transform 160ms ease,
      background-color 180ms ease,
      opacity 180ms ease,
      box-shadow 180ms ease;
  }

  .profile-primary-action:hover,
  .profile-primary-action:focus-visible {
    background: var(--candidate-primary-hover);
    transform: translateY(-1px);
  }

  .profile-primary-action:active {
    transform: translateY(0) scale(0.99);
  }

  .profile-primary-action:disabled {
    cursor: not-allowed;
    opacity: 0.72;
    transform: none;
  }

  .profile-skeleton {
    position: relative;
    overflow: hidden;
    background: #dbe7e5;
  }

  .profile-skeleton::after {
    position: absolute;
    inset: 0;
    content: "";
    transform: translateX(-100%);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
    animation: profile-shimmer 1.15s infinite;
  }
}

@media (min-width: 640px) {
  @layer components {
    .profile-hero,
    .profile-section {
      padding: 1.5rem;
    }
  }
}

@media (min-width: 1024px) {
  @layer components {
    .app-footer {
      grid-template-columns: minmax(18rem, 1fr) auto minmax(18rem, 1fr);
    }

    .app-footer__links {
      justify-content: center;
    }

    .app-footer__meta {
      justify-content: flex-end;
    }

    .profile-hero {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.72fr);
      align-items: center;
      min-height: 26rem;
      padding: 2rem;
    }

    .profile-preview {
      padding: 1.25rem;
      transform: rotate(1deg);
    }

    .profile-section {
      border-radius: 1.25rem;
      padding: 1.5rem;
    }
  }
}

@keyframes route-panel-enter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes mobile-drawer-enter {
  from {
    opacity: 0;
    transform: translateX(-1.25rem);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes profile-shimmer {
  to {
    transform: translateX(100%);
  }
}

@keyframes profile-reveal {
  from {
    opacity: 0;
    transform: translateY(14px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
  }

  .route-panel,
  .app-mobile-drawer__panel,
  .profile-hero__content,
  .profile-preview,
  .profile-section {
    animation-duration: 1ms !important;
    animation-delay: 0ms !important;
    transform: none !important;
  }

  .profile-skeleton::after {
    animation: none;
  }

  .profile-primary-action,
  .profile-field__control,
  .profile-textarea {
    transition: background-color 1ms linear, border-color 1ms linear, color 1ms linear !important;
  }

  .profile-primary-action .animate-spin {
    animation: none !important;
  }

  .candidate-skeleton::after {
    animation: none;
  }
}
