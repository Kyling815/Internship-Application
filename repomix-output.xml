@router.put("/jobs/{job_id}", response_model=schemas.JobPostingRead)
def update_hr_job(
    job_id: int,
    payload: schemas.JobPostingUpdate,
    db: Session = Depends(get_db),
    current_user: models.User = Depends(require_role("hr", "admin")),
):
