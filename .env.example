# Root environment used by docker-compose.

# App
ENVIRONMENT=development
APP_DEBUG=true
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL for backend container
POSTGRES_DB=internship_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/internship_tracker

# Backend API
BACKEND_PORT=8001
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8001
VITE_CHAT_API_BASE_URL=http://localhost:3000

# JWT shared by backend and chat-service
SECRET_KEY=replace-this-with-a-long-random-secret
JWT_SECRET=replace-this-with-the-same-value-as-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File storage
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.txt,.png,.jpg,.jpeg

# Optional S3 storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=
S3_ENDPOINT_URL=
# Leave blank for private S3 documents. The app generates presigned URLs instead.
S3_PUBLIC_BASE_URL=

# Chat service
NODE_ENV=development
PORT=3000
CHAT_PORT=3000
CHAT_CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_ADAPTER_REQUIRED=false
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_USERS_TABLE=ChatUsers
DYNAMODB_GROUPS_TABLE=ChatGroups
DYNAMODB_MESSAGES_TABLE=ChatMessages
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Local observability
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

LOKI_PORT=3100
ALLOY_PORT=12345

GRAFANA_VERSION=latest
LOKI_VERSION=latest
ALLOY_VERSION=latest
# Local metrics
PROMETHEUS_PORT=9090
PROMETHEUS_VERSION=v3.5.3

CADVISOR_PORT=8080
CADVISOR_VERSION=v0.60.5